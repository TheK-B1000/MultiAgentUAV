# Runtime training logs — ephemeral, not tracked
logs/
*.log
*.err.log
*.out.log
*.log.smoke

# Python generated files
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# IDE
.idea/
.vscode/

# Virtual environment
.venv/

# OS
.DS_Store
Thumbs.db

# Model checkpoints — large binaries, referenced by path+sha256 in frozen JSON
# records instead (e.g. CCP_S2_MODELS_FROZEN.json, RSCFT_MODELS_FROZEN.json).
# Regenerable from a training run; not committed.
**/ckpts/*.zip
**/verify_ckpts/*.zip
