# Runtime training logs — ephemeral, not tracked
logs/
*.log
*.err.log
*.out.log
*.log.smoke

# Python generated files
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# IDE
.idea/
.vscode/

# Virtual environment
.venv/

# OS
.DS_Store
Thumbs.db

# Model checkpoints — large binaries, referenced by path+sha256 in frozen JSON
# records instead (e.g. CCP_S2_MODELS_FROZEN.json, RSCFT_MODELS_FROZEN.json).
# Regenerable from a training run; not committed.
**/ckpts/*.zip
**/verify_ckpts/*.zip

# Figure-style smoke-test output (the __main__ demo in paper/figures/dars_bar_style.py).
# Not a paper figure; the real ones are paper/generated/figN_*.{pdf,png}.
paper/generated/_smoke_test*

# NON-SCIENTIFIC train_scale smoke output (99_9xx_xxx seeds). Regenerable in
# minutes and never eligible for evaluation; the launcher itself is tracked.
artifacts/scale_*/smoke_scale_*/

# NON-SCIENTIFIC train_specialist_scale smoke/dry-run output (99_9xx_xxx seeds).
artifacts/scale_*_specialists/smoke_*/
